// Port of Compiler/AST.ts (ASTParser). Like the TS parser, it renames
// variables, functions and structs while parsing by rewriting token
// lexemes in place, and tokens are shared between AST nodes, so the order
// of those rewrites matters

//----------------------------------------------------------------------
// Symbol table, mapping names to the token they were declared with
//----------------------------------------------------------------------

struct ParserBinding {
  Text name;
  Token token;
}

struct ParserEnv {
  array ParserBinding items;
  int length;
}

struct ParserSymbolTable {
  array ParserEnv envs;
  int length;
}

function ParserSymbolTable parser_symbol_table_new() {
  return new ParserSymbolTable(new ParserEnv[8], 0);
}

function void parser_push_environment(ParserSymbolTable table) {
  if (table.length == length(table.envs)) {
    array ParserEnv old_envs = table.envs;
    array ParserEnv new_envs = new ParserEnv[length(old_envs) * 2];

    for (int i = 0; i < table.length; i = i + 1) {
      new_envs[i] = old_envs[i];
    }

    table.envs = new_envs;
    delete old_envs;
  }

  table.envs[table.length] = new ParserEnv(new ParserBinding[8], 0);
  table.length = table.length + 1;
}

function void parser_pop_environment(ParserSymbolTable table) {
  if (table.length > 0) {
    table.length = table.length - 1;
  }
}

function ParserBinding parser_env_find(ParserEnv env, Text name) {
  for (int i = 0; i < env.length; i = i + 1) {
    if (text_equals(env.items[i].name, name)) {
      return env.items[i];
    }
  }

  return null;
}

// Binds name in the innermost environment, replacing an existing binding.
// Does nothing when there are no environments, like the TS SymbolTable
function void parser_symbol_add(ParserSymbolTable table, Text name, Token token) {
  if (table.length > 0) {
    ParserEnv env = table.envs[table.length - 1];
    ParserBinding existing = parser_env_find(env, name);

    if (existing != null) {
      existing.token = token;
    } else {
      if (env.length == length(env.items)) {
        array ParserBinding old_items = env.items;
        array ParserBinding new_items = new ParserBinding[length(old_items) * 2];

        for (int i = 0; i < env.length; i = i + 1) {
          new_items[i] = old_items[i];
        }

        env.items = new_items;
        delete old_items;
      }

      env.items[env.length] = new ParserBinding(text_copy(name), token);
      env.length = env.length + 1;
    }
  }
}

function bool parser_exists_in_curr_env(ParserSymbolTable table, Text name) {
  if (table.length == 0) {
    return false;
  }

  return parser_env_find(table.envs[table.length - 1], name) != null;
}

// Returns the token bound to name in the innermost environment that has
// it, or null
function Token parser_symbol_get(ParserSymbolTable table, Text name) {
  for (int i = table.length - 1; i >= 0; i = i - 1) {
    ParserBinding binding = parser_env_find(table.envs[i], name);

    if (binding != null) {
      return binding.token;
    }
  }

  return null;
}

//----------------------------------------------------------------------
// Parser state
//----------------------------------------------------------------------

Token curr_token = null;

// The namespace that we are operating in
Text global_namespace = null;

// Needed by the pretty printer
bool should_transform_name = true;

// Determines how the variable names will be transformed
TextList name_prefix = null;

// Used to determine the right prefix
int count_if = 0;
int count_for = 0;
int count_while = 0;
int count_elseif = 0;
int count_else = 0;

ParserSymbolTable parser_symbols = null;

function void parser_init(Text source, string namespace, bool transform_names) {
  lexer_init(source);
  curr_token = null;
  global_namespace = text_from_string(namespace);
  should_transform_name = transform_names;
  name_prefix = text_list_new();
  text_list_push(name_prefix, text_copy(global_namespace));
  parser_symbols = parser_symbol_table_new();
}

//----------------------------------------------------------------------
// Helper functions
//----------------------------------------------------------------------

function void parser_error(string message) {
  parser_error_text(text_from_string(message));
}

function void parser_error_text(Text message) {
  print("Grammar error (line ");
  print(curr_token.line);
  print(", column ");
  print(curr_token.column);
  print("): ");
  text_print(message);
  print(" found ");
  text_print(curr_token.lexeme);
  print("\n");
  error("");
}

// Moves to the next token of the lexer, skipping comments
function void advance() {
  curr_token = lexer_next_token();

  while (curr_token.type == TT_COMMENT) {
    token_delete(curr_token);
    curr_token = lexer_next_token();
  }
}

function bool match(int token_type) {
  return curr_token.type == token_type;
}

// Advances to next token if current token type matches given one,
// otherwise produces an error with the given message
function void eat(int token_type, string message) {
  if (not match(token_type)) {
    parser_error(message);
  }

  advance();
}

function bool is_bin_op() {
  int t = curr_token.type;

  return (t == TT_PLUS) or (t == TT_MINUS) or (t == TT_TIMES) or (t == TT_DIVIDE) or
    (t == TT_AND) or (t == TT_OR) or (t == TT_EQUAL) or (t == TT_LESS) or
    (t == TT_GREATER) or (t == TT_LESS_EQ) or (t == TT_GREATER_EQ) or
    (t == TT_NOT_EQUAL) or (t == TT_MOD);
}

function bool is_base_type() {
  int t = curr_token.type;
  return (t == TT_INT_TYPE) or (t == TT_DOUBLE_TYPE) or (t == TT_BOOL_TYPE) or (t == TT_STRING_TYPE);
}

function bool is_data_type_start() {
  return is_base_type() or match(TT_ID) or match(TT_ARRAY);
}

function bool is_stmt_start() {
  int t = curr_token.type;

  return (t == TT_WHILE) or (t == TT_IF) or (t == TT_FOR) or (t == TT_RETURN) or
    (t == TT_ID) or (t == TT_ARRAY) or (t == TT_DELETE) or is_base_type();
}

function bool is_expr_start() {
  int t = curr_token.type;

  return (t == TT_NOT) or (t == TT_LPAREN) or (t == TT_INT_VAL) or (t == TT_DOUBLE_VAL) or
    (t == TT_BOOL_VAL) or (t == TT_STRING_VAL) or (t == TT_NULL_VAL) or (t == TT_NEW) or
    (t == TT_ID);
}

// Matches BUILT_INS in Compiler/WasmHelper.ts
function bool is_built_in(Text name) {
  if (text_equals_string(name, "print")) { return true; }
  if (text_equals_string(name, "input")) { return true; }
  if (text_equals_string(name, "itos")) { return true; }
  if (text_equals_string(name, "itod")) { return true; }
  if (text_equals_string(name, "dtos")) { return true; }
  if (text_equals_string(name, "dtoi")) { return true; }
  if (text_equals_string(name, "stoi")) { return true; }
  if (text_equals_string(name, "stod")) { return true; }
  if (text_equals_string(name, "length")) { return true; }
  if (text_equals_string(name, "get")) { return true; }
  if (text_equals_string(name, "allocate_memory")) { return true; }
  if (text_equals_string(name, "mem_copy")) { return true; }
  if (text_equals_string(name, "get_array_pointer")) { return true; }
  if (text_equals_string(name, "array_int_to_string")) { return true; }
  if (text_equals_string(name, "string_to_array_int")) { return true; }
  if (text_equals_string(name, "error")) { return true; }
  if (text_equals_string(name, "deallocate_memory")) { return true; }
  if (text_equals_string(name, "delete_i32_array")) { return true; }
  if (text_equals_string(name, "i32_load")) { return true; }
  if (text_equals_string(name, "i32_store")) { return true; }
  if (text_equals_string(name, "delete_struct")) { return true; }
  if (text_equals_string(name, "sleep")) { return true; }
  if (text_equals_string(name, "random")) { return true; }
  if (text_equals_string(name, "length_string")) { return true; }
  if (text_equals_string(name, "string_print")) { return true; }
  if (text_equals_string(name, "string_append")) { return true; }
  if (text_equals_string(name, "string_compare")) { return true; }
  if (text_equals_string(name, "char_code")) { return true; }
  if (text_equals_string(name, "chars_to_string")) { return true; }

  return false;
}

// Replaces the token's lexeme
function void set_lexeme(Token token, Text lexeme) {
  text_delete(token.lexeme);
  token.lexeme = lexeme;
}

// Returns the global namespace + "_" + name, used for namespaces
function Text with_global_namespace(Text name) {
  Text result = text_copy(global_namespace);
  text_append_string(result, "_");
  text_append(result, name);
  return result;
}

function Text get_name_with_prefix(Text name) {
  if (not should_transform_name) {
    return text_copy(name);
  }

  // The TS parser looks up this.prefix[-1], which is always undefined in
  // JS, so the count is always 0
  if (parser_exists_in_curr_env(parser_symbols, name)) {
    Text result = text_list_join(name_prefix, "_");
    text_append_string(result, "0_");
    text_append(result, name);
    return result;
  } else {
    Token binding = parser_symbol_get(parser_symbols, name);

    if (binding != null) {
      return text_copy(binding.lexeme);
    }
  }

  if (global_namespace.length > 0) {
    return with_global_namespace(name);
  }

  return text_copy(name);
}

function void transform_name(Token token) {
  set_lexeme(token, get_name_with_prefix(token.lexeme));
}

// Pushes e.g. "if3" onto the name prefix
function void push_prefix(string scope_type, int count) {
  Text prefix = text_from_string(scope_type);
  string count_str = itos(count);
  text_append_string(prefix, count_str);
  delete count_str;
  text_list_push(name_prefix, prefix);
}

function DataType data_type_new() {
  return new DataType(false, null, null);
}

//----------------------------------------------------------------------
// Recursive descent functions
//----------------------------------------------------------------------

// Start the parser, returning a Program AST node
function Program parse() {
  Program program_node = new Program(
    struct_def_list_new(),
    fun_def_list_new(),
    var_decl_list_new(),
    import_list_new()
  );

  advance();

  while (not match(TT_EOS)) {
    if (match(TT_STRUCT)) {
      struct_def(program_node.struct_defs);
    } elseif (match(TT_FUNCTION) or match(TT_EXPORT)) {
      bool should_export = match(TT_EXPORT);

      if (should_export) {
        advance();
      }

      eat(TT_FUNCTION, "(112) Was expecting 'function'");
      fun_def(program_node.fun_defs, should_export);
    } elseif (match(TT_IMPORT)) {
      advance();

      Text file_name = text_copy(curr_token.lexeme);
      Text namespace = text_new();

      eat(TT_STRING_VAL, "(104) Import token must be followed by the file name as a string");
      eat(TT_AS, "(106) Was expecting 'as'");

      if (match(TT_TIMES) or match(TT_ID)) {
        if (match(TT_ID)) {
          text_append(namespace, curr_token.lexeme);
        }

        advance();
      } else {
        eat(TT_ID, "(107) Was expecting an ID or the wildcard character");
      }

      eat(TT_SEMICOLON, "(105) Import statement must be followed by a semicolon");

      import_list_push(program_node.imports, new Import(file_name, namespace));
    } else {
      var_decl_list_push(program_node.vdecl_stmts, vdecl_stmt(false, null, true, null));
      eat(TT_SEMICOLON, "Was expecting a semicolon");
    }
  }

  eat(TT_EOS, "expecting EOF");

  return program_node;
}

// NOTE: first token must be STRUCT
// Grammar: STRUCT ID LBRACE <fields> RBRACE
function void struct_def(StructDefList struct_defs) {
  // Advancing since we know that the first token is a STRUCT
  advance();

  StructDef struct_node = new StructDef(curr_token, var_def_list_new());

  transform_name(struct_node.struct_name);

  eat(TT_ID, "(1) structs must begin with an ID, but");
  eat(TT_LBRACE, "(2) struct IDs must be succeeded by an LBRACE");
  fields(struct_node.fields);
  eat(TT_RBRACE, "(3) structs must have a closing RBRACE");

  struct_def_list_push(struct_defs, struct_node);
}

// Grammar: <data_type> ID ( SEMICOLON <data_type> ID )∗ | ϵ
function void fields(VarDefList field_list) {
  while (is_data_type_start()) {
    DataType data_type = data_type_new();
    parse_data_type(data_type);

    VarDef field = new VarDef(data_type, curr_token);

    eat(TT_ID, "(4) Data type must be succeeded by an ID");
    eat(TT_SEMICOLON, "(62) Was expecting semicolon, but");

    var_def_list_push(field_list, field);
  }
}

// Grammar: <base_type> | (ID :: | ϵ) ID | ARRAY ( <base_type> | ID )
function void parse_data_type(DataType data_type) {
  if (not is_data_type_start()) {
    parser_error("(7) Data types must be an ID, BASE_TYPE or an array");
  }

  if (match(TT_ARRAY)) {
    // Advance from the ARRAY token
    advance();
    data_type.is_array = true;
  }

  bool was_id = match(TT_ID);

  if (is_base_type() or was_id) {
    if (not was_id) {
      data_type.type_name = curr_token;
      advance();
    } else {
      bool has_namespace = false;
      Token id_token = curr_token;
      advance();

      if (match(TT_SCOPE_RESOLUTION)) {
        advance();

        data_type.namespace = id_token;
        set_lexeme(id_token, with_global_namespace(id_token.lexeme));

        data_type.type_name = curr_token;

        eat(TT_ID, "(109) The scope resolution operator must be followed by an ID");
        has_namespace = true;
      } else {
        data_type.type_name = id_token;
      }

      if (not has_namespace) {
        transform_name(data_type.type_name);
      }
    }
  } else {
    parser_error("(6) Was expecting a user-defined type or a base type");
  }
}

// Grammar: (EXPORT | ϵ) FUNCTION ( <data_type> | VOID_TYPE ) ID LPAREN <params> RPAREN  LBRACE ( <stmt> )∗ RBRACE
function void fun_def(FunDefList fun_defs, bool should_export) {
  parser_push_environment(parser_symbols);

  // Resetting the count for each function
  count_if = 0;
  count_for = 0;
  count_while = 0;
  count_elseif = 0;
  count_else = 0;

  DataType return_type = data_type_new();
  VarDefList param_list = var_def_list_new();
  StmtList stmts = stmt_list_new();

  if (match(TT_VOID_TYPE)) {
    return_type.is_array = false;
    return_type.type_name = curr_token;

    advance();
  } else {
    // it must be a <data_type>
    parse_data_type(return_type);
  }

  Token fun_name = curr_token;
  Text original_fun_name = text_copy(fun_name.lexeme);

  transform_name(fun_name);

  text_list_push(name_prefix, text_copy(fun_name.lexeme));

  eat(TT_ID, "(8) Functions must have an ID, but");
  eat(TT_LPAREN, "(9) Function IDs must be succeeded by an LPAREN, but");

  params(param_list);

  eat(TT_RPAREN, "(10) Functions must have a closing RPAREN after the parameter list, but");
  eat(TT_LBRACE, "(11) The closing RPAREN must be followed by an LBRACE, but ");

  if (match(TT_RBRACE)) {
    advance();
  } else {
    // Since it isn't an RBRACE, it must have atleast one stmt
    stmt(stmts);

    // Checking if it is still an stmt:
    while (is_stmt_start()) {
      stmt(stmts);
    }

    eat(TT_RBRACE, "(12) Functions must have a matching closing RBRACE, but");
  }

  fun_def_list_push(
    fun_defs,
    new FunDef(return_type, fun_name, param_list, stmts, original_fun_name, should_export)
  );

  text_list_pop(name_prefix);
  parser_pop_environment(parser_symbols);
}

// Parses one parameter: <data_type> ID
function void param(VarDefList param_list, string id_error) {
  DataType data_type = data_type_new();

  parse_data_type(data_type);

  var_def_list_push(param_list, new VarDef(data_type, curr_token));

  parser_symbol_add(parser_symbols, curr_token.lexeme, curr_token);
  transform_name(curr_token);

  eat(TT_ID, id_error);
}

// Grammar: <data_type> ID ( COMMA <data_type> ID )∗ | ϵ
function void params(VarDefList param_list) {
  if (is_data_type_start()) {
    param(param_list, "(13) Function parameter types must be followed by an ID, but");

    while (match(TT_COMMA)) {
      // Advance from the COMMA
      advance();
      param(param_list, "(14) Function parameter types must be followed by an ID, but");
    }
  }
}

// Grammar: <while_stmt> | <if_stmt> | <for_stmt> | <return_stmt> SEMICOLON |
//          <vdecl_stmt> SEMICOLON | <assign_stmt> SEMICOLON | <call_expr> SEMICOLON
function void stmt(StmtList stmts) {
  if (is_base_type() or match(TT_ARRAY)) {
    Stmt var_decl = stmt_new(STMT_VAR_DECL);
    var_decl.var_decl = vdecl_stmt(false, null, false, null);
    stmt_list_push(stmts, var_decl);

    eat(TT_SEMICOLON, "(15) Variable declarations must be followed by a semicolon, but");
  } elseif (match(TT_DELETE)) {
    stmt_list_push(stmts, delete_stmt());
  } elseif (match(TT_WHILE)) {
    stmt_list_push(stmts, while_stmt());
  } elseif (match(TT_IF)) {
    stmt_list_push(stmts, if_stmt());
  } elseif (match(TT_FOR)) {
    stmt_list_push(stmts, for_stmt());
  } elseif (match(TT_RETURN)) {
    stmt_list_push(stmts, return_stmt());

    eat(TT_SEMICOLON, "(27) return statememts must end with a semicolon, but");
  } elseif (match(TT_ID)) {
    Token id_token = curr_token;
    Token namespace = null;

    advance();

    if (match(TT_SCOPE_RESOLUTION)) {
      advance();
      namespace = id_token;
      set_lexeme(namespace, with_global_namespace(namespace.lexeme));
      id_token = curr_token;

      eat(TT_ID, "(109) The scope resolution operator must be followed by an ID");
    }

    DataType data_type = new DataType(false, id_token, namespace);

    if (match(TT_LPAREN)) {
      if ((not is_built_in(id_token.lexeme)) and (namespace == null)) {
        transform_name(id_token);
      }

      Stmt call_stmt = stmt_new(STMT_CALL);
      call_stmt.call_expr = call_expr(id_token, namespace);
      call_stmt.call_expr.is_stmt = true;
      stmt_list_push(stmts, call_stmt);

      eat(TT_SEMICOLON, "(17) Call expressions must be followed by a semicolon, but");
    } elseif (match(TT_ID)) {
      Stmt var_decl = stmt_new(STMT_VAR_DECL);
      var_decl.var_decl = vdecl_stmt(true, data_type, false, namespace);
      stmt_list_push(stmts, var_decl);

      eat(TT_SEMICOLON, "(60) Variable declarations must be followed by a semicolon, but");
    } else {
      transform_name(id_token);

      Stmt assign = stmt_new(STMT_ASSIGN);
      assign.assign_stmt = assign_stmt(data_type);
      stmt_list_push(stmts, assign);

      eat(TT_SEMICOLON, "(18) Assign statements must be followed by a semicolon, but");
    }
  }
}

function Stmt delete_stmt() {
  // Advancing from delete
  advance();

  Token id_token = curr_token;

  transform_name(id_token);
  advance();

  Stmt result = stmt_new(STMT_DELETE);
  result.delete_target = var_rvalue(new DataType(false, id_token, null));

  eat(TT_SEMICOLON, "(111) Was expecting a semicolon");

  return result;
}

function StmtList block_stmts() {
  StmtList stmt_list = stmt_list_new();

  while (is_stmt_start()) {
    stmt(stmt_list);
  }

  return stmt_list;
}

// Grammar: IF LPAREN <expr> RPAREN LBRACE ( <stmt> )∗ RBRACE <if_stmt_t>
function Stmt if_stmt() {
  count_if = count_if + 1;
  push_prefix("if", count_if);
  parser_push_environment(parser_symbols);

  eat(TT_IF, "(49) if statements must begin with IF, but");
  eat(TT_LPAREN, "(50) IF must be followed by an opening LPAREN");

  Expr condition = expr();

  eat(TT_RPAREN, "(51) IF expressions must be followed by a closing RPAREN");
  eat(TT_LBRACE, "(52) Was expecting LBRACE, but");

  StmtList stmt_list = block_stmts();

  eat(TT_RBRACE, "(53) Was expecting closing RBRACE, but");

  BasicIfList else_ifs = basic_if_list_new();
  StmtList else_stmts = stmt_list_new();

  parser_pop_environment(parser_symbols);
  text_list_pop(name_prefix);

  if_stmt_t(else_ifs, else_stmts);

  Stmt result = stmt_new(STMT_IF);
  result.if_stmt = new IfStmt(new BasicIf(condition, stmt_list), else_ifs, else_stmts);
  return result;
}

// Grammar: ELSEIF LPAREN <expr> RPAREN LBRACE ( <stmt> )∗ RBRACE <if_stmt_t> |
//          ELSE LBRACE ( <stmt> )∗ RBRACE |
//          ϵ
function void if_stmt_t(BasicIfList else_ifs, StmtList else_stmts) {
  if (match(TT_ELSEIF)) {
    count_elseif = count_elseif + 1;
    push_prefix("elseif", count_elseif);

    parser_push_environment(parser_symbols);

    advance();
    eat(TT_LPAREN, "(54) elseif keyword must be followed by LPAREN, but");

    Expr condition = expr();

    eat(TT_RPAREN, "(55) Was expecting closing RPAREN, but");
    eat(TT_LBRACE, "(56) Was expecting LBRACE, but");

    StmtList stmt_list = block_stmts();

    eat(TT_RBRACE, "(57) Was expecting closing RBRACE, but");

    basic_if_list_push(else_ifs, new BasicIf(condition, stmt_list));

    parser_pop_environment(parser_symbols);
    text_list_pop(name_prefix);

    if_stmt_t(else_ifs, else_stmts);
  } elseif (match(TT_ELSE)) {
    count_else = count_else + 1;
    push_prefix("else", count_else);

    parser_push_environment(parser_symbols);

    advance();
    eat(TT_LBRACE, "(58) Was expecting LBRACE, but");

    StmtList stmt_list = block_stmts();

    for (int i = 0; i < stmt_list.length; i = i + 1) {
      stmt_list_push(else_stmts, stmt_list.items[i]);
    }

    eat(TT_RBRACE, "(59) Was expecting closing RBRACE, but");

    parser_pop_environment(parser_symbols);
    text_list_pop(name_prefix);
  }
}

// Grammar: WHILE LPAREN <expr> RPAREN LBRACE ( <stmt> )∗ RBRACE
function Stmt while_stmt() {
  count_while = count_while + 1;
  push_prefix("while", count_while);

  parser_push_environment(parser_symbols);

  eat(TT_WHILE, "(44) while statements must begin with WHILE, but");
  eat(TT_LPAREN, "(45) WHILE must be followed by an opening LPAREN");

  Expr condition = expr();

  eat(TT_RPAREN, "(46) WHILE expressions must be followed by a closing RPAREN");
  eat(TT_LBRACE, "(47) Was expecting LBRACE, but");

  StmtList stmt_list = block_stmts();

  eat(TT_RBRACE, "(48) Was expecting closing RBRACE, but");

  parser_pop_environment(parser_symbols);
  text_list_pop(name_prefix);

  Stmt result = stmt_new(STMT_WHILE);
  result.while_stmt = new WhileStmt(condition, stmt_list);
  return result;
}

// Grammar: FOR LPAREN <vdecl_stmt> SEMICOLON <expr> SEMICOLON
//          <assign_stmt> <RPAREN> LBRACE ( <stmt> )∗ RBRACE
function Stmt for_stmt() {
  count_for = count_for + 1;
  push_prefix("for", count_for);

  parser_push_environment(parser_symbols);

  // String literals can't contain a double quote (34), so this message is
  // built by hand
  if (not match(TT_FOR)) {
    Text message = text_from_string("(19) For statememnts must begin with the keyword ");
    text_push(message, 34);
    text_append_string(message, "for");
    text_push(message, 34);
    text_append_string(message, ", but");
    parser_error_text(message);
  }

  advance();
  eat(TT_LPAREN, "(20) for keyword must be followed by an LPAREN, but");

  VarDecl var_decl = vdecl_stmt(false, null, false, null);

  eat(TT_SEMICOLON, "(21) for's variable declarations must be followed by a semicolon, but");

  Expr condition = expr();

  eat(TT_SEMICOLON, "(22) for's conditional expressions must be followed by a semicolon, but");

  transform_name(curr_token);

  DataType data_type = new DataType(false, curr_token, null);

  eat(TT_ID, "(61) Was expecting ID, but");

  AssignStmt assign = assign_stmt(data_type);

  eat(TT_RPAREN, "(23) for's assignment statements must be followed by an RPAREN, but");
  eat(TT_LBRACE, "(24) for's RPAREN but be followed by an LBRACE, but");

  StmtList stmt_list = block_stmts();

  eat(TT_RBRACE, "(25) for must have have matching closing RBRACE, but");

  parser_pop_environment(parser_symbols);
  text_list_pop(name_prefix);

  Stmt result = stmt_new(STMT_FOR);
  result.for_stmt = new ForStmt(var_decl, condition, assign, stmt_list);
  return result;
}

// Grammar: RETURN <expr> SEMICOLON
function Stmt return_stmt() {
  eat(TT_RETURN, "(26) return statements must begin with RETURN, but");

  Stmt result = stmt_new(STMT_RETURN);
  result.expr = expr();
  return result;
}

// NOTE: ID must be eaten before calling this method
// Grammar: <lvalue> ASSIGN <expr>
function AssignStmt assign_stmt(DataType data_type) {
  VarRefList lvalues = lvalue(data_type);

  eat(TT_ASSIGN, "(28) Lvalues must be followed by an ASSIGN, but");

  return new AssignStmt(lvalues, expr());
}

// Grammar: (ID :: | ϵ) ID ( LBRACKET <expr> RBRACKET | ϵ ) ( DOT ID ( LBRACKET <expr> RBRACKET | ϵ ) )∗
function VarRefList lvalue(DataType data_type) {
  VarRef var_ref = new VarRef(data_type.type_name, null);
  VarRefList var_ref_list = var_ref_list_new();

  var_ref_list_push(var_ref_list, var_ref);

  if (match(TT_LBRACKET)) {
    advance();
    var_ref.array_expr = expr();
    eat(TT_RBRACKET, "(30) Missing matching RBRACKET,");
  }

  while (match(TT_DOT)) {
    advance();

    var_ref = new VarRef(curr_token, null);
    var_ref_list_push(var_ref_list, var_ref);

    eat(TT_ID, "(31) DOT must be followed by an ID, but");

    if (match(TT_LBRACKET)) {
      advance();
      var_ref.array_expr = expr();
      eat(TT_RBRACKET, "(32) Missing matching RBRACKET,");
    }
  }

  return var_ref_list;
}

// NOTE: ID MUST BE EATEN BEFORE CALLING THIS METHOD
// Grammar: ID (:: ID | ϵ) LPAREN ( <expr> ( COMMA <expr> )∗ | ϵ ) RPAREN
function CallExpr call_expr(Token id_token, Token namespace) {
  ExprList expr_list = expr_list_new();

  eat(TT_LPAREN, "(33) call expression IDs must be followed by an LPAREN");

  if (is_expr_start()) {
    expr_list_push(expr_list, expr());

    while (match(TT_COMMA)) {
      advance();
      expr_list_push(expr_list, expr());
    }
  }

  eat(TT_RPAREN, "(34) Missing matching RPAREN");

  return new CallExpr(id_token, expr_list, namespace, false);
}

// Grammar: <data_type> ID ( ASSIGN <expr> | ϵ )
function VarDecl vdecl_stmt(bool has_eaten_type, DataType data_type, bool expect_literal, Token namespace) {
  if (not has_eaten_type) {
    data_type = data_type_new();
    parse_data_type(data_type);
  }

  if (has_eaten_type and (namespace == null)) {
    transform_name(data_type.type_name);
  }

  VarDef var_def = new VarDef(data_type, curr_token);
  Expr value = null;

  parser_symbol_add(parser_symbols, curr_token.lexeme, curr_token);
  transform_name(curr_token);

  eat(TT_ID, "(35) Data types must be followed by an ID, but");

  if (match(TT_ASSIGN)) {
    advance();

    value = expr();

    if (expect_literal) {
      if ((value.op != null) or (value.rest != null)) {
        parser_error("(101) Global variables must have a literal value");
      }

      if (value.first.kind != TERM_SIMPLE) {
        parser_error("(103) Global variables must have a literal value");
      } elseif (value.first.rvalue.kind != RV_SIMPLE) {
        parser_error("(103) Global variables must have a literal value");
      }
    }
  } elseif (expect_literal) {
    parser_error("(102) Global variables must be initialized");
  }

  return new VarDecl(var_def, value);
}

// Returns how tightly the current binary operator binds; higher binds
// tighter
function int bin_op_precedence(int token_type) {
  if (token_type == TT_OR) { return 1; }
  if (token_type == TT_AND) { return 2; }
  if ((token_type == TT_EQUAL) or (token_type == TT_NOT_EQUAL)) { return 3; }
  if ((token_type == TT_PLUS) or (token_type == TT_MINUS)) { return 5; }
  if ((token_type == TT_TIMES) or (token_type == TT_DIVIDE) or (token_type == TT_MOD)) { return 6; }

  // LESS, GREATER, LESS_EQ, GREATER_EQ
  return 4;
}

// Turns an expression into a term that can be used as an operand
function ExprTerm as_term(Expr e) {
  if ((e.op == null) and (not e.not_op)) {
    return e.first;
  }

  return complex_term(e);
}

// Grammar: <operand> ( <bin_op> <operand> )∗
// Binary operators are left-associative and grouped by precedence
function Expr expr() {
  return binary_expr(0);
}

// Precedence climbing. Each operation is built as if it were fully
// parenthesized, so `a - b * c - d` becomes `(a - (b * c)) - d`
function Expr binary_expr(int min_precedence) {
  Expr left = operand();
  bool done = false;

  while (not done) {
    done = true;

    if (is_bin_op()) {
      if (bin_op_precedence(curr_token.type) > min_precedence) {
        done = false;

        Token op = curr_token;
        advance();

        Expr right = binary_expr(bin_op_precedence(op.type));

        left = new Expr(
          false,
          as_term(left),
          op,
          new Expr(false, as_term(right), null, null)
        );
      }
    }
  }

  return left;
}

// Grammar: <rvalue> | NOT <expr> | LPAREN <expr> RPAREN
function Expr operand() {
  if (match(TT_NOT)) {
    // not applies to everything after it, e.g. `not a == b` is `not (a == b)`
    advance();
    Expr e = expr();
    e.not_op = not e.not_op;
    return e;
  }

  if (match(TT_LPAREN)) {
    advance();
    ExprTerm first = complex_term(expr());
    eat(TT_RPAREN, "(36) Missing closing RPAREN. ");
    return new Expr(false, first, null, null);
  }

  return new Expr(false, simple_term(rvalue()), null, null);
}

// Grammar: ID ( LBRACKET <expr> RBRACKET | ϵ ) ( DOT ID ( LBRACKET <expr> RBRACKET | ϵ ) )∗
function VarRValue var_rvalue(DataType data_type) {
  return new VarRValue(lvalue(data_type));
}

// Grammar: <base_rvalue> | NULL_VAL | <new_rvalue> | <var_rvalue> | <call_expr>
function RValue rvalue() {
  RValue val = null;
  int t = curr_token.type;

  if ((t == TT_NULL_VAL) or (t == TT_INT_VAL) or (t == TT_DOUBLE_VAL) or (t == TT_BOOL_VAL) or (t == TT_STRING_VAL)) {
    val = rvalue_new(RV_SIMPLE);
    val.value = curr_token;
    advance();
  } elseif (match(TT_NEW)) {
    val = rvalue_new(RV_NEW);
    val.new_rvalue = new_rvalue();
  } elseif (match(TT_ID)) {
    Token id_token = curr_token;

    advance();

    if (match(TT_LPAREN) or match(TT_SCOPE_RESOLUTION)) {
      Token namespace = null;

      if (match(TT_SCOPE_RESOLUTION)) {
        advance();
        namespace = id_token;
        set_lexeme(namespace, with_global_namespace(namespace.lexeme));
        id_token = curr_token;

        eat(TT_ID, "(109) The scope resolution operator must be followed by an ID");
      }

      if ((not is_built_in(id_token.lexeme)) and (namespace == null)) {
        transform_name(id_token);
      }

      val = rvalue_new(RV_CALL);
      val.call_expr = call_expr(id_token, namespace);
    } else {
      transform_name(id_token);
      val = rvalue_new(RV_VAR);
      val.var_rvalue = var_rvalue(new DataType(false, id_token, null));
    }
  } else {
    parser_error("(43) Malformed rvalue. ");
  }

  return val;
}

// Grammar: NEW (ID :: | ϵ ) ID LPAREN ( <expr> ( COMMA <expr> )∗ | ϵ ) RPAREN |
//          NEW ( (ID :: | ϵ ) ID  | <base_type> ) LBRACKET <expr> RBRACKET
function NewRValue new_rvalue() {
  Token type_name = null;
  ExprList struct_params = null;
  Expr array_expr = null;

  // Advancing NEW
  advance();

  Token namespace = null;

  if (match(TT_ID)) {
    type_name = curr_token;
    advance();

    if (match(TT_SCOPE_RESOLUTION)) {
      advance();
      namespace = type_name;
      set_lexeme(namespace, with_global_namespace(namespace.lexeme));
      type_name = curr_token;

      eat(TT_ID, "(110) The scope resolution operator must be followed by an ID");
    } else {
      transform_name(type_name);
    }

    if (match(TT_LPAREN)) {
      advance();

      struct_params = expr_list_new();

      if (is_expr_start()) {
        expr_list_push(struct_params, expr());
      }

      while (match(TT_COMMA)) {
        advance();
        expr_list_push(struct_params, expr());
      }

      eat(TT_RPAREN, "(37) Missing closing RPAREN");
    } else {
      eat(TT_LBRACKET, "(38) Missing opening LBRACKET");
      array_expr = expr();
      eat(TT_RBRACKET, "(39) Missing closing RBRACKET");
    }
  } else {
    if (not is_base_type()) {
      parser_error("(40) Was expecting a BASE_TYPE");
    }

    type_name = curr_token;

    advance();
    eat(TT_LBRACKET, "(41) Missing opening LBRACKET");
    array_expr = expr();
    eat(TT_RBRACKET, "(42) Missing closing RBRACKET");
  }

  return new NewRValue(type_name, array_expr, struct_params, namespace);
}
