// The types a built-in accepts for its first argument, or null when it
// isn't overloaded. Only first arguments are overloaded
function DataTypeList overloaded_types(Text fun_name) {
  DataTypeList types = null;

  if (text_equals_string(fun_name, "print")) {
    types = data_type_list_new();
    data_type_list_push(types, DT_INT);
    data_type_list_push(types, DT_DOUBLE);
    data_type_list_push(types, DT_BOOL);
    data_type_list_push(types, DT_STRING);
  }

  if (text_equals_string(fun_name, "length")) {
    types = data_type_list_new();
    data_type_list_push(types, DT_ANY_ARRAY);
    data_type_list_push(types, DT_STRING);
  }

  if (text_equals_string(fun_name, "get_array_pointer")) {
    types = data_type_list_new();
    data_type_list_push(types, DT_ANY_ARRAY);
    data_type_list_push(types, DT_STRING);
  }

  if (text_equals_string(fun_name, "delete_struct")) {
    types = data_type_list_new();
    data_type_list_push(types, DT_ANY_STRUCT);
  }

  return types;
}
